        {
          "name": "Create Draft Challan (Admin/Sales)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.data && jsonData.data.challan && jsonData.data.challan.id) {",
                  "        pm.collectionVariables.set('challanId', jsonData.data.challan.id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"quantity\": 2\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/challans",
              "host": ["{{baseUrl}}"],
              "path": ["api", "challans"]
            },
            "description": "Create a new Sales Challan draft"
          },
          "response": []
        },
        {
          "name": "Get Challan Detail",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/challans/{{challanId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "challans", "{{challanId}}"]
            },
            "description": "Get single challan with product snapshots"
          },
          "response": []
        },
        {
          "name": "Confirm Challan (Atomic Stock Deduction)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/challans/{{challanId}}/confirm",
              "host": ["{{baseUrl}}"],
              "path": ["api", "challans", "{{challanId}}", "confirm"]
            },
            "description": "Confirm challan and deduct inventory atomically"
          },
          "response": []
        },
        {
          "name": "Cancel Draft Challan",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
