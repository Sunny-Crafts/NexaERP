            ],
            "url": {
              "raw": "{{baseUrl}}/api/challans/{{challanId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["api", "challans", "{{challanId}}", "cancel"]
            },
            "description": "Cancel a draft challan"
          },
          "response": []
        }
