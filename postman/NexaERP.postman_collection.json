            },
            "description": "Search customers by name, mobile, business name, or email"
          },
          "response": []
        },
        {
          "name": "Create Customer (Admin/Sales)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.data && jsonData.data.customer && jsonData.data.customer.id) {",
                  "        pm.collectionVariables.set('customerId', jsonData.data.customer.id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rohan Singhania\",\n  \"mobile\": \"+91 9988776655\",\n  \"email\": \"rohan@singhaniatraders.in\",\n  \"businessName\": \"Singhania Global Traders\",\n  \"gstNumber\": \"27AABCS1234E1ZR\",\n  \"customerType\": \"DISTRIBUTOR\",\n  \"address\": \"Industrial Area Phase 2, Pune, Maharashtra\",\n  \"status\": \"ACTIVE\",\n  \"followUpDate\": \"2026-08-20T10:00:00.000Z\",\n  \"notes\": \"Large scale regional distributor for electronics\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/customers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "customers"]
            },
            "description": "Create a new customer (Admin or Sales only)"
          },
          "response": []
