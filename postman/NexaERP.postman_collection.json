        {
          "name": "Create Product (Admin/Warehouse)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.data && jsonData.data.product && jsonData.data.product.id) {",
                  "        pm.collectionVariables.set('productId', jsonData.data.product.id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bluetooth Ergonomic Headset\",\n  \"sku\": \"AUD-HD-006\",\n  \"category\": \"Audio\",\n  \"unitPrice\": 1899.00,\n  \"currentStock\": 60,\n  \"minimumStock\": 15,\n  \"warehouseLocation\": \"Rack D-02\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"]
            },
            "description": "Create a new product (Admin/Warehouse only)"
          },
          "response": []
        },
